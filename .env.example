# Required for the Claude assistant
ANTHROPIC_API_KEY=
# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=8787
# Shared password for the site (strongly recommended when deployed)
APP_PASSWORD=
# Second password for the private Ring & Proposal section (leave unset = nobody can open it)
RING_PASSWORD=
# Where the planner data file lives (use a persistent disk in production)
DATA_FILE=
